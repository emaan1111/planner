// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Plan Events (calendar items)
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  planType    String?
  color       String
  isAllDay    Boolean  @default(false)
  tags        String[] @default([])
  priority    String?  // low, medium, high, urgent
  status      String   @default("scheduled") // scheduled, in-progress, done, reschedule, no-action
  notes       String?
  projectId   String?
  recurrence  Json?    // RecurrencePattern structure
  parentEventId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tasks       Task[]
  decisions   Decision[]
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentEvent Event?    @relation("Recurrence", fields: [parentEventId], references: [id], onDelete: SetNull)
  recurringInstances Event[] @relation("Recurrence")
}

// Tasks linked to plan types or events
model Task {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("todo") // todo, in-progress, scheduled, done, stuck
  priority       String   @default("medium") // low, medium, high
  bucket         String   @default("active") // inbox | active | someday
  archived       Boolean  @default(false)
  startDate      DateTime?
  dueDate        DateTime?
  category       String?
  linkedPlanType String?
  linkedEventId  String?
  projectId      String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  linkedEvent    Event?   @relation(fields: [linkedEventId], references: [id], onDelete: SetNull)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([bucket])
  @@index([archived])
}

// Key Decisions
model Decision {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         String    @default("pending") // pending, decided, deferred
  outcome        String?
  notes          String?
  linkedPlanType String?
  linkedEventId  String?
  projectId      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  linkedEvent    Event?    @relation(fields: [linkedEventId], references: [id], onDelete: SetNull)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// Projects for organizing events, tasks, and decisions
model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("blue")
  isActive    Boolean  @default(true)
  archived    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events      Event[]
  tasks       Task[]
  decisions   Decision[]
}

// Plan Types (all user-configurable, no default/custom distinction)
model PlanType {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String
  color     String
  icon      String   @default("Star")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Constraints for scheduling rules
model Constraint {
  id          String   @id @default(cuid())
  name        String
  type        String   // date-range, no-overlap, dependency, resource, custom
  description String
  ruleType    String
  ruleParams  Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Planning Context for AI assistance
model PlanningContext {
  id          String   @id @default(cuid())
  type        String   // constraint, assumption, goal, preference, note
  title       String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// AI Assistant Messages (optional - for chat history)
model AIMessage {
  id         String   @id @default(cuid())
  role       String   // user, assistant
  content    String
  createdAt  DateTime @default(now())
}

// ----------------------------------------------------------------------------
// CFO Scenarios feature: course-based planning calendars with P&L projections
// ----------------------------------------------------------------------------

// Reusable course definition that can be dropped onto any scenario calendar
model CourseTemplate {
  id                            String   @id @default(cuid())
  name                          String   @unique
  description                   String?
  marketingDurationDays         Int      @default(14)
  deliveryDurationDays          Int      @default(7)
  defaultGapDays                Int      @default(0) // days between marketing end and delivery start
  defaultPricePerChild          Float    @default(0)
  defaultCostPerRun             Float    @default(0)
  defaultProjectedRegistrations Int      @default(0)
  defaultLikelihoodPercent      Int      @default(70)
  defaultRisks                  String?
  defaultNotes                  String?
  marketingColor                String   @default("purple")
  deliveryColor                 String   @default("blue")
  // Membership courses bill on a recurring cadence; revenue projects with churn over a retention horizon.
  isMembership                  Boolean  @default(false)
  billingPeriodDays             Int      @default(30)
  defaultMonthlyChurnPercent    Float    @default(5)
  defaultRetentionMonths        Int      @default(12)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  placements CoursePlacement[]
}

// Folder grouping for scenarios
model ScenarioFolder {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("indigo")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenarios Scenario[]
}

// A planning calendar (one named scenario)
model Scenario {
  id          String   @id @default(cuid())
  name        String
  description String?
  folderId    String?
  color       String   @default("indigo")
  notes       String?
  order       Int      @default(0)
  isBest      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folder     ScenarioFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  placements CoursePlacement[]
  events     ScenarioEvent[]
}

// ----------------------------------------------------------------------------
// CFO Financial Models: horizon-based P&L projections for the org.
// ----------------------------------------------------------------------------

model FinancialModel {
  id            String   @id @default(cuid())
  name          String
  description   String?
  caseType      String   @default("baseline") // baseline | best | worst | custom
  horizonMonths Int      @default(24)
  startMonth    DateTime
  startingCash  Float    @default(0)
  taxPercent    Float    @default(0)
  notes         String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines     ModelLine[]
  headcount ModelHeadcount[]
}

model ModelLine {
  id                   String   @id @default(cuid())
  modelId              String
  name                 String
  kind                 String // revenue | cost
  category             String?
  inputMode            String // flat | growth | manual | linked-scenario | driver
  flatAmount           Float?
  startAmount          Float?
  monthlyGrowthPercent Float?
  manualValues         Json?
  linkedScenarioId     String?
  linkedField          String? // revenue | cost | profit
  driverPercent        Float?
  driverBase           String? // revenue | cost | memberCount
  order                Int      @default(0)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  model FinancialModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model ModelHeadcount {
  id              String    @id @default(cuid())
  modelId         String
  name            String
  role            String?
  annualSalary    Float     @default(0)
  startMonth      DateTime
  endMonth        DateTime?
  benefitsPercent Float     @default(20)
  notes           String?
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  model FinancialModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

// Holidays, key dates, and free-form notes pinned to a scenario calendar.
// Kept separate from the global Event model so scenarios don't leak into the main planner.
model ScenarioEvent {
  id         String   @id @default(cuid())
  scenarioId String
  title      String
  startDate  DateTime
  endDate    DateTime
  color      String   @default("amber")
  kind       String   @default("note") // note | holiday | milestone
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
}

// A course placed on a scenario calendar — carries per-scenario dials
model CoursePlacement {
  id                     String   @id @default(cuid())
  scenarioId             String
  courseTemplateId       String
  startDate              DateTime // marketing start date
  deliveryStartDate      DateTime // independent — can be days, weeks, or months after marketing ends
  marketingDurationDays  Int
  deliveryDurationDays   Int
  pricePerChild          Float
  costPerRun             Float
  projectedRegistrations Int
  likelihoodPercent      Int      @default(70)
  risks                  String?
  notes                  String?
  // Membership overrides (mirror template defaults at creation time, editable per scenario)
  isMembership                 Boolean  @default(false)
  monthlyChurnPercent          Float    @default(5)
  retentionMonths              Int      @default(12)
  // Entry funnel: 'direct' or 'trial-to-paid'
  entryMode                    String   @default("direct")
  trialDurationDays            Int      @default(0)
  trialToPaidConversionPercent Float    @default(100)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  scenario       Scenario       @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  courseTemplate CourseTemplate @relation(fields: [courseTemplateId], references: [id], onDelete: Restrict)

  @@index([scenarioId])
  @@index([courseTemplateId])
}

// ----------------------------------------------------------------------------
// Documents: word-doc style editor with a dual text / slide view. The body is
// stored as an ordered list of blocks (paragraphs); slide boundaries and slide
// titles live on the blocks themselves, so the document and the slides are a
// single source of truth (reordering slides physically moves their blocks).
// ----------------------------------------------------------------------------
model Doc {
  id        String   @id @default(cuid())
  title     String   @default("Untitled document")
  blocks    Json     @default("[]") // DocBlock[]: { id, text, slideStart?, slideTitle? }
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
